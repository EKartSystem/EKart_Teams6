@using System.Text.Json;
@using EKartMVC.Models;

@{
    ViewData["Title"] = "Order Confirmation";
}

<div class="container py-5">

    <div class="text-center mb-5">
        <div class="d-inline-flex align-items-center justify-content-center bg-success text-white rounded-circle shadow-sm mb-3" style="width: 80px; height: 80px;">
            <i class="bi bi-check-lg fs-1"></i>
        </div>
        <h1 class="fw-bold text-dark">Order Confirmed</h1>
        <p class="text-muted">Your transaction has been processed successfully. Thank you for choosing EKart.</p>
    </div>

    @if (TempData["OrderItems"] != null)
    {
        var orderItems = JsonSerializer.Deserialize<List<CartItem>>(TempData["OrderItems"].ToString()) ?? new List<CartItem>();
        var requiredDate = TempData["RequiredDate"]?.ToString();
        var totalPrice = orderItems.Sum(item => item.GetTotal());
        var totalQuantity = orderItems.Sum(item => item.Quantity);

        <div class="row justify-content-center">
            <div class="col-lg-10">

                <div class="card shadow-sm border-0 mb-4">
                    <div class="card-header bg-primary text-white py-3">
                        <h6 class="m-0 fw-bold"><i class="bi bi-receipt me-2"></i>Transaction Summary</h6>
                    </div>
                    <div class="card-body p-0">
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0">
                                <thead class="table-light text-secondary small text-uppercase fw-bold">
                                    <tr>
                                        <th class="ps-4">Product Description</th>
                                        <th class="text-center">Quantity</th>
                                        <th class="text-end">Unit Price</th>
                                        <th class="text-end pe-4">Subtotal</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in orderItems)
                                    {
                                        <tr>
                                            <td class="ps-4">
                                                <div class="fw-bold text-dark">@item.ProductName</div>
                                            </td>
                                            <td class="text-center">
                                                <span class="badge bg-light text-dark border px-3">@item.Quantity</span>
                                            </td>
                                            <td class="text-end text-muted">@item.UnitPrice.ToString("C")</td>
                                            <td class="text-end fw-bold text-dark pe-4">@item.GetTotal().ToString("C")</td>
                                        </tr>
                                    }
                                </tbody>
                                <tfoot class="table-light">
                                    <tr>
                                        <td colspan="3" class="text-end fw-bold py-3">Grand Total:</td>
                                        <td class="text-end fw-bold text-primary h5 py-3 pe-4">@totalPrice.ToString("C")</td>
                                    </tr>
                                </tfoot>
                            </table>
                        </div>
                    </div>
                    <div class="card-footer bg-white py-3 border-top-0">
                        <div class="row align-items-center">
                            <div class="col-md-6">
                                <span class="text-muted small text-uppercase fw-bold">Total Items Processed:</span>
                                <span class="ms-2 fw-bold text-dark">@totalQuantity</span>
                            </div>
                            <div class="col-md-6 text-md-end">
                                @if (!string.IsNullOrEmpty(requiredDate))
                                {
                                    <span class="text-muted small text-uppercase fw-bold">Expected Delivery:</span>
                                    <span class="ms-2 fw-bold text-dark">@requiredDate</span>
                                }
                            </div>
                        </div>
                    </div>
                </div>

                <div class="d-flex justify-content-center gap-3">
                    <a asp-action="MyOrders" class="btn btn-outline-primary rounded-pill px-4 fw-bold shadow-sm">
                        <i class="bi bi-list-ul me-1"></i> View My Orders
                    </a>
                    <a asp-action="Index" asp-controller="Shop" class="btn btn-secondary rounded-pill px-4 fw-semibold">
                        <i class="bi bi-cart me-1"></i> Continue Shopping
                    </a>
                </div>
            </div>
        </div>
    }
</div>
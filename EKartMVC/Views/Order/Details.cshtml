@model EKartMVC.ViewModel.OrderDetailsViewModel

@{
    ViewData["Title"] = "Order Specification";
}

<div class="container-fluid py-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold text-dark mb-1">
                <i class="bi bi-receipt-cutoff text-primary me-2"></i>Order Specification
            </h2>
            <p class="text-muted small mb-0">Detailed breakdown of transaction records and fulfillment logistics.</p>
        </div>
        <a asp-action="MyOrders" asp-route-customerId="@Model.Order.CustomerId" class="btn btn-outline-secondary rounded-pill px-4 fw-semibold shadow-sm">
            <i class="bi bi-arrow-left me-1"></i> Back to Order History
        </a>
    </div>

    <div class="row g-4">

        <div class="col-lg-4">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-header bg-primary text-white py-3">
                    <h6 class="m-0 fw-bold"><i class="bi bi-info-circle me-2"></i>Order Summary</h6>
                </div>
                <div class="card-body p-4">
                    <div class="mb-4">
                        <label class="form-label fw-semibold text-secondary small text-uppercase">Reference ID</label>
                        <div class="h5 fw-bold text-dark">#@Model.Order.OrderId</div>
                    </div>

                    <div class="mb-4 text-center py-3 bg-light rounded-3 border">
                        <label class="form-label fw-semibold text-secondary small text-uppercase d-block">Total Transaction Value</label>
                        <div class="h3 fw-bold text-primary mb-0">@Model.GetTotalPrice().ToString("C2")</div>
                    </div>

                    <div class="mb-4">
                        <label class="form-label fw-semibold text-secondary small text-uppercase">Transaction Date</label>
                        <div class="text-dark">
                            <i class="bi bi-calendar3 me-2 text-primary"></i>
                            @Model.Order.OrderDate?.ToString("MMMM dd, yyyy")
                        </div>
                    </div>

                    <div class="mb-0">
                        <label class="form-label fw-semibold text-secondary small text-uppercase">Shipping Destination</label>
                        <div class="text-dark small">
                            <i class="bi bi-geo-alt me-2 text-primary"></i>
                            @Model.Order.ShipAddress<br />
                            <span class="ms-4">@Model.Order.ShipCity, @Model.Order.ShipCountry</span>
                        </div>
                    </div>

                    <div class="mt-4">
                        <label class="form-label fw-semibold text-secondary small text-uppercase">Shipment Status</label>
                        @if (Model.Order.ShippedDate.HasValue)
                        {
                            <div class="text-success fw-bold small mb-2">
                                <i class="bi bi-check-circle me-1"></i> Shipped on @Model.Order.ShippedDate.Value.ToString("MMMM dd, yyyy")
                            </div>
                        }
                        else
                        {
                            <div class="text-warning fw-bold small mb-2">
                                <i class="bi bi-clock me-1"></i> Pending Shipment
                            </div>
                        }
                        @if (Context.Session.GetString("role") == "Admin")
                        {
                            <form asp-action="UpdateStatus" method="post">
                                <input type="hidden" name="id" value="@Model.Order.OrderId" />
                                <input type="hidden" name="markShipped" value="@(!Model.Order.ShippedDate.HasValue ? "true" : "false")" />
                                <button type="submit" class="btn btn-sm @(Model.Order.ShippedDate.HasValue ? "btn-outline-warning" : "btn-outline-success") rounded-pill w-100 fw-bold">
                                    @(Model.Order.ShippedDate.HasValue ? "Mark as Unshipped" : "Mark as Shipped")
                                </button>
                            </form>
                        }
                    </div>
                </div>
                <div class="card-footer bg-white border-top-0 py-3">
                    <div class="d-grid">
                        <button class="btn btn-sm btn-outline-primary rounded-pill" onclick="window.print()">
                            <i class="bi bi-printer me-1"></i> Print Invoice
                        </button>
                    </div>
                </div>
            </div>
        </div>

        
        <div class="col-lg-8">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-dark text-white py-3">
                    <h6 class="m-0 fw-bold"><i class="bi bi-box-seam me-2"></i>Line Item Details</h6>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light text-secondary small text-uppercase fw-bold">
                                <tr>
                                    <th class="ps-4">Product Name</th>
                                    <th class="text-center">Quantity</th>
                                    <th class="text-end">Unit Price</th>
                                    <th class="text-end pe-4">Subtotal</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.OrderDetails)
                                {
                                    <tr>
                                        <td class="ps-4">
                                            <div class="fw-bold text-dark">@item.ProductName</div>
                                        </td>
                                        <td class="text-center">
                                            <span class="badge bg-light text-dark border px-3">@item.Quantity</span>
                                        </td>
                                        <td class="text-end text-muted small">@item.UnitPrice.ToString("C2")</td>
                                        <td class="text-end fw-bold text-dark pe-4">
                                            @((item.Quantity * item.UnitPrice).ToString("C2"))
                                        </td>
                                    </tr>
                                }
                            </tbody>
                            <tfoot class="table-light">
                                <tr>
                                    <td colspan="3" class="text-end fw-bold py-3">Order Grand Total:</td>
                                    <td class="text-end fw-bold text-primary h5 py-3 pe-4">
                                        @Model.GetTotalPrice().ToString("C2")
                                    </td>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>

    @if (Context.Session.GetString("role") == "Admin")
    {
        <div class="row mt-4">
            <div class="col-lg-6">
                <div class="card shadow-sm border-0">
                    <div class="card-header bg-primary text-white py-3">
                        <h6 class="m-0 fw-bold"><i class="bi bi-gear me-2"></i>Fulfillment Settings</h6>
                    </div>
                    <div class="card-body p-4">
                        <form asp-action="UpdateFulfillment" method="post">
                            <input type="hidden" name="id" value="@Model.Order.OrderId" />
                            <div class="mb-3">
                                <label class="form-label fw-semibold text-secondary small text-uppercase">Assigned Employee</label>
                                <select name="employeeId" class="form-select">
                                    <option value="">— Unassigned —</option>
                                    @if (ViewBag.Employees != null)
                                    {
                                        foreach (var emp in ViewBag.Employees)
                                        {
                                            if (Model.Order.EmployeeId == emp.EmployeeId)
                                            {
                                                <option value="@emp.EmployeeId" selected>@emp.FullName</option>
                                            }
                                            else
                                            {
                                                <option value="@emp.EmployeeId">@emp.FullName</option>
                                            }
                                        }
                                    }
                                </select>
                            </div>
                            <div class="mb-3">
                                <label class="form-label fw-semibold text-secondary small text-uppercase">Shipper</label>
                                <select name="shipVia" class="form-select">
                                    <option value="">— None —</option>
                                    @if (ViewBag.Shippers != null)
                                    {
                                        foreach (var shipper in ViewBag.Shippers)
                                        {
                                            if (Model.Order.ShipVia == shipper.ShipperId)
                                            {
                                                <option value="@shipper.ShipperId" selected>@shipper.CompanyName</option>
                                            }
                                            else
                                            {
                                                <option value="@shipper.ShipperId">@shipper.CompanyName</option>
                                            }
                                        }
                                    }
                                </select>
                            </div>
                            <div class="mb-4">
                                <label class="form-label fw-semibold text-secondary small text-uppercase">Freight Cost</label>
                                <div class="input-group">
                                    <span class="input-group-text">₹</span>
                                    <input type="number" name="freight" step="0.01" min="0" class="form-control"
                                           value="@Model.Order.Freight" placeholder="0.00" />
                                </div>
                            </div>
                            <button type="submit" class="btn btn-primary w-100 fw-bold rounded-pill">
                                <i class="bi bi-save me-1"></i> Save Fulfillment
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    }
</div>
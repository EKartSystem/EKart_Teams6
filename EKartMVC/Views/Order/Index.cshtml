@model EKartMVC.ViewModel.PaginationViewModel<EKartMVC.ViewModel.OrderListItemViewModel>

@{
    ViewData["Title"] = "Order History";
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold text-dark mb-1">
                <i class="bi bi-clock-history text-primary me-2"></i>Order History
            </h2>
            <p class="text-muted small mb-0">Review past transactions, fulfillment status, and delivery logistics.</p>
        </div>
        <div class="d-flex gap-2">
            <span class="badge bg-primary-subtle text-primary rounded-pill px-3 py-2 fw-bold align-self-center">
                @Model.TotalItems Total Orders
            </span>
            <a asp-action="Index" asp-controller="Shop" class="btn btn-outline-primary rounded-pill px-4 fw-semibold shadow-sm">
                <i class="bi bi-cart-plus me-1"></i> New Purchase
            </a>
        </div>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-header bg-primary text-white py-3">
            <h6 class="m-0 fw-bold"><i class="bi bi-journal-text me-2"></i>Transaction Ledger</h6>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light text-secondary small text-uppercase fw-bold">
                        <tr>
                            <th class="ps-4">Reference ID</th>
                            <th>Placement Date</th>
                            <th>Shipping Destination</th>
                            <th>Total Value</th>
                            <th class="text-center">Status</th>
                            <th class="text-center pe-4">Operations</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.Items)
                        {
                            <tr>
                                <td class="ps-4">
                                    <span class="fw-bold text-dark">#@item.Order.OrderId</span>
                                </td>
                                <td>
                                    <div class="text-dark">@item.Order.OrderDate?.ToString("MMM dd, yyyy")</div>
                                    <small class="text-muted x-small">Fulfillment Logged</small>
                                </td>
                                <td>
                                    <div class="d-flex align-items-center">
                                        <i class="bi bi-geo-alt text-primary me-2"></i>
                                        <div class="small">
                                            <div class="text-dark fw-semibold">@item.Order.ShipAddress</div>
                                            <div class="text-muted">@item.Order.ShipCity, @item.Order.ShipCountry</div>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <span class="fw-bold text-primary">@item.TotalPrice.ToString("C2")</span>
                                </td>
                                <td class="text-center">
                                    @if (item.Order.ShippedDate.HasValue)
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success fw-bold">Shipped</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning-subtle text-warning border border-warning fw-bold">Pending</span>
                                    }
                                </td>
                                <td class="text-center pe-4">
                                    <a asp-action="Details" asp-route-id="@item.Order.OrderId"
                                       class="btn btn-sm btn-outline-primary rounded-pill px-4 fw-bold shadow-sm">
                                        <i class="bi bi-search me-1"></i> View Details
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
        <div class="card-footer bg-white py-3">
            <div class="d-flex justify-content-between align-items-center">
                <p class="text-muted small mb-0">
                    <i class="bi bi-info-circle me-1"></i> Showing @((Model.CurrentPage - 1) * Model.PageSize + 1) to
                    @Math.Min(Model.CurrentPage * Model.PageSize, Model.TotalItems) of @Model.TotalItems orders
                </p>
                @if (Model.TotalPages > 1)
                {
                    <nav>
                        <ul class="pagination mb-0">
                            <li class="page-item @(!Model.HasPreviousPage ? "disabled" : "")">
                                <a class="page-link fw-bold" asp-action="Index" asp-route-pageNumber="1">&laquo;&laquo;</a>
                            </li>
                            <li class="page-item @(!Model.HasPreviousPage ? "disabled" : "")">
                                <a class="page-link fw-bold" asp-action="Index" asp-route-pageNumber="@(Model.CurrentPage - 1)">&laquo;</a>
                            </li>
                            <li class="page-item disabled">
                                <span class="page-link fw-bold">@Model.CurrentPage of @Model.TotalPages</span>
                            </li>
                            <li class="page-item @(!Model.HasNextPage ? "disabled" : "")">
                                <a class="page-link fw-bold" asp-action="Index" asp-route-pageNumber="@(Model.CurrentPage + 1)">&raquo;</a>
                            </li>
                            <li class="page-item @(!Model.HasNextPage ? "disabled" : "")">
                                <a class="page-link fw-bold" asp-action="Index" asp-route-pageNumber="@Model.TotalPages">&raquo;&raquo;</a>
                            </li>
                        </ul>
                    </nav>
                }
            </div>
        </div>
    </div>
</div>

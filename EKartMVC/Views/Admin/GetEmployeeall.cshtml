@model IEnumerable<E_Kart_Application.DTOs.EmployeeDto.EmployeeListingDto>

@{
    ViewData["Title"] = "Employee Management";
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold text-dark">Employee Management</h2>
            <p class="text-muted small mb-0">Manage staff roles, hierarchy, and assigned territories.</p>
        </div>
        <a asp-action="Create" class="btn btn-primary rounded-pill px-4 shadow-sm fw-bold">
            <i class="bi bi-person-plus-fill me-2"></i>Add New Employee
        </a>
    </div>

    <div class="row g-3 mb-4 text-center">
        <div class="col-md-3">
            <div class="card border-0 shadow-sm bg-light py-2">
                <div class="small text-muted text-uppercase fw-semibold">Total Staff</div>
                <div class="h5 mb-0 fw-bold">@Model.Count()</div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm bg-light py-2">
                <div class="small text-muted text-uppercase fw-semibold">Managers</div>
                <div class="h5 mb-0 fw-bold text-success">@Model.Count(x => x.IsManager)</div>
            </div>
        </div>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-header bg-primary text-white py-3">
            <h6 class="m-0 fw-bold"><i class="bi bi-person-badge-fill me-2"></i>Staff Directory</h6>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light text-secondary small text-uppercase">
                        <tr>
                            <th class="ps-4">ID</th>
                            <th>Full Name</th>
                            <th>Title / Designation</th>
                            <th class="text-center">Manager Status</th>
                            <th class="text-center">Reports</th>
                            <th class="text-center pe-4">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="ps-4 fw-bold">#@item.EmployeeId</td>
                                <td>
                                    <div class="fw-bold text-dark">@item.FullName</div>
                                </td>
                                <td>
                                    <span class="badge bg-light text-primary border px-2 py-2 fw-semibold">
                                        @item.Title
                                    </span>
                                </td>
                                <td class="text-center">
                                    @if (item.IsManager)
                                    {
                                        <span class="badge bg-success-subtle text-success rounded-pill px-3">Yes</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-light text-muted rounded-pill px-3">No</span>
                                    }
                                </td>
                                <td class="text-center">
                                    @if (item.IsManager)
                                    {
                                        <span class="fw-bold">@item.TotalEmployeesUnderManager</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">—</span>
                                    }
                                </td>
                                <td class="text-center pe-4">
                                    <div class="btn-group shadow-sm">
                                        <a asp-action="Edit" asp-route-id="@item.EmployeeId" class="btn btn-sm btn-outline-warning" title="Edit Staff">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                        <a asp-action="GetEmployeeid" asp-route-id="@item.EmployeeId" class="btn btn-sm btn-outline-info" title="View Profile">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                        <a asp-action="GetTerritory" asp-route-id="@item.EmployeeId" class="btn btn-sm btn-outline-primary" title="Territories">
                                            <i class="bi bi-geo-alt"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
        <div class="card-footer bg-white py-3 border-top-0">
            <p class="text-muted small mb-0">Showing system employees based on Northwind organizational hierarchy.</p>
        </div>
    </div>
</div>
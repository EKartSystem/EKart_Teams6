@using E_Kart_Application.DTOs.Customersdto
@model List<CustomerDto>

@{
    ViewData["Title"] = "Top Customers";
}

<div class="container-fluid py-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold text-dark mb-1">
                <i class="bi bi-award text-primary me-2"></i>Top Customers
            </h2>
            <p class="text-muted small mb-0">Ranking of customers based on total order volume and engagement.</p>
        </div>
        <a class="btn btn-outline-secondary rounded-pill px-4 fw-semibold shadow-sm" asp-controller="Admin" asp-action="Customers">
            <i class="bi bi-arrow-left me-1"></i> Back to Directory
        </a>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-header bg-primary text-white py-3">
            <h6 class="m-0 fw-bold"><i class="bi bi-graph-up-arrow me-2"></i>Customer Performance Rankings</h6>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light text-secondary small text-uppercase fw-bold">
                        <tr>
                            <th class="ps-4">Rank</th>
                            <th>Customer Identity</th>
                            <th>Contact Info</th>
                            <th>Primary Address</th>
                            <th class="text-center pe-4">Total Orders</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{
                            int rank = 1;
                        }
                        @foreach (var customer in Model)
                        {
                            <tr>
                                <td class="ps-4">
                                    @if (rank <= 3)
                                    {
                                        <span class="badge rounded-circle bg-warning text-dark p-2 shadow-sm" style="width: 30px; height: 30px; display: inline-flex; align-items: center; justify-content: center;">
                                            @rank
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-muted fw-bold ms-2">@rank</span>
                                    }
                                </td>
                                <td>
                                    <div class="fw-bold text-dark">@customer.ContactName</div>
                                    <div class="text-muted x-small">UID: @customer.CustomerId</div>
                                </td>
                                <td>
                                    <div class="small"><i class="bi bi-telephone text-primary me-1"></i> @(string.IsNullOrEmpty(customer.Phone) ? "N/A" : customer.Phone)</div>
                                </td>
                                <td>
                                    <span class="text-truncate d-inline-block small" style="max-width: 250px;" title="@customer.Address">
                                        @customer.Address
                                    </span>
                                </td>
                                <td class="text-center pe-4">
                                    <span class="badge bg-primary-subtle text-primary rounded-pill px-3 py-2 fw-bold">
                                        @customer.TotalOrders Orders
                                    </span>
                                </td>
                            </tr>
                            rank++;
                        }
                    </tbody>
                </table>
            </div>
        </div>
        <div class="card-footer bg-white py-3 border-top-0">
            <p class="text-muted small mb-0">Showing top performance metrics based on system transaction history.</p>
        </div>
    </div>
</div>
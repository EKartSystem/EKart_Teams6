@model List<EKartMVC.Models.CartItem>

@{
    ViewData["Title"] = "Your Shopping Cart";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold text-dark">
            <i class="bi bi-cart3 text-primary me-2"></i>Shopping Cart
        </h2>
        <span class="badge bg-primary rounded-pill px-3">@Model?.Count Items</span>
    </div>

    @if (Model == null || Model.Count == 0)
    {
        <div class="card border-0 shadow-sm text-center py-5">
            <div class="card-body">
                <i class="bi bi-cart-x display-1 text-muted mb-3"></i>
                <h4 class="text-secondary">Your cart is currently empty</h4>
                <p class="text-muted mb-4">Looks like you haven't added anything to your cart yet.</p>
                <a href="@Url.Action("Index", "Shop")" class="btn btn-primary rounded-pill px-4 shadow-sm">
                    Start Shopping
                </a>
            </div>
        </div>
    }
    else
    {
        <div class="card shadow-sm border-0 mb-4">
            <div class="card-header bg-primary text-white py-3">
                <h6 class="m-0 fw-bold"><i class="bi bi-list-check me-2"></i>Order Summary</h6>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light text-secondary small text-uppercase fw-bold">
                            <tr>
                                <th class="ps-4">Product Details</th>
                                <th>Unit Price</th>
                                <th>Quantity</th>
                                <th>Subtotal</th>
                                <th class="text-center pe-4">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td class="ps-4">
                                        <div class="fw-bold text-dark">@item.ProductName</div>
                                        <small class="text-muted">In Stock: @item.UnitsInStock</small>
                                    </td>
                                    <td>@item.UnitPrice.ToString("C2")</td>
                                    <td>
                                        <form asp-action="UpdateQuantity" method="get" class="d-flex align-items-center gap-1">
                                            <input type="hidden" name="productId" value="@item.ProductId" />
                                            <div class="input-group input-group-sm" style="max-width: 150px;">
                                                <button type="button" class="btn btn-outline-secondary qty-btn" data-action="minus" data-id="@item.ProductId">−</button>
                                                <input type="number" name="quantity" id="qty-@item.ProductId"
                                                       value="@item.Quantity" min="1" max="@item.UnitsInStock"
                                                       class="form-control text-center bg-white" readonly />
                                                <button type="button" class="btn btn-outline-secondary qty-btn" data-action="plus" data-id="@item.ProductId" data-max="@item.UnitsInStock">+</button>
                                                <button type="submit" class="btn btn-primary" title="Apply Update">
                                                    <i class="bi bi-check-lg"></i> ->
                                                </button>
                                            </div>
                                        </form>
                                    </td>
                                    <td class="fw-bold text-primary">@item.GetTotal().ToString("C2")</td>
                                    <td class="text-center pe-4">
                                        <a asp-action="RemoveFromCart" asp-route-productId="@item.ProductId"
                                               class="btn btn-sm btn-outline-danger rounded-pill px-3">
                                            <i class="bi bi-trash me-1"></i> Remove
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                        <tfoot class="table-light border-top-0">
                            <tr>
                                <td colspan="3" class="text-end fw-bold py-3">Total Amount:</td>
                                <td class="fw-bold text-dark h5 py-3">@Model.Sum(x => x.GetTotal()).ToString("C2")</td>
                                <td></td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div>
        </div>

        <div class="d-flex flex-column flex-md-row justify-content-between gap-3">
            <div>
                <a asp-action="ClearCart" class="btn btn-outline-danger rounded-pill px-4"
                       onclick="return confirm('Are you sure you want to clear your entire cart?')">
                    <i class="bi bi-trash3 me-1"></i> Clear Cart
                </a>
            </div>
            <div class="d-flex gap-2">
                <a asp-action="Index" asp-controller="Shop" class="btn btn-outline-secondary rounded-pill px-4">
                    Continue Shopping
                </a>
                <a asp-action="Checkout" asp-controller="Order" class="btn btn-success rounded-pill px-4 fw-bold shadow-sm">
                    Proceed to Checkout <i class="bi bi-arrow-right ms-1"></i>
                </a>
            </div>
        </div>
    }
</div>

<script>
    document.querySelectorAll('.qty-btn').forEach(btn => {
        btn.addEventListener('click', function () {
            const id = this.dataset.id;
            const input = document.getElementById('qty-' + id);
            const min = parseInt(input.min);
            const max = parseInt(input.max);
            let val = parseInt(input.value);

            if (this.dataset.action === 'plus') {
                if (val < max) input.value = val + 1;
            } else {
                if (val > min) input.value = val - 1;
            }
        });
    });
</script>
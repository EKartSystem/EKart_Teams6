<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - EKartMVC</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
</head>
<body class="bg-light">
    @{
        var name = Context.Session.GetString("username");
        var role = Context.Session.GetString("role");
        var isLoggedIn = !string.IsNullOrWhiteSpace(name);
        var isAdmin = string.Equals(role, "Admin", StringComparison.OrdinalIgnoreCase);
        var dashboardController = isAdmin ? "Admin" : "Customer";
        var dashboardAction = isAdmin ? "AdminDashboard" : "CustomerDashboard";
        var profileController = isAdmin ? "Admin" : "Customer";
    }

    <nav class="navbar navbar-expand-lg navbar-dark bg-dark px-3 shadow-sm">
        <a class="navbar-brand fw-semibold" asp-controller="@dashboardController" asp-action="@dashboardAction">E-Kart</a>

        <div class="ms-auto">
            @if (isLoggedIn)
            {
                <div class="dropdown">
                    <button class="btn btn-dark dropdown-toggle d-flex align-items-center gap-2"
                            type="button"
                            id="userMenuButton"
                            data-bs-toggle="dropdown"
                            aria-expanded="false">
                        <span>@name</span>
                    </button>

                    <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="userMenuButton">
                        @if (isAdmin)
                        {
                            <a class="dropdown-item" asp-controller="@profileController" asp-action="Profile">
                                Profile
                            </a>
                        }
                        else
                        {
                            <a class="dropdown-item disabled text-muted" href="#" tabindex="-1" aria-disabled="true">
                                Your Profile
                            </a>
                        }
                        <li>
                            <a class="dropdown-item text-danger" asp-controller="Account" asp-action="Logout">Logout</a>
                        </li>
                    </ul>
                </div>
            }
            else
            {
                <a class="btn btn-outline-light btn-sm" asp-controller="Account" asp-action="Login">Login</a>
            }
        </div>
    </nav>

    <main class="container py-4">
        @RenderBody()
    </main>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

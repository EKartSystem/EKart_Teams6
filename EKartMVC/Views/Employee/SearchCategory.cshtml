@model IEnumerable<E_Kart_Application.DTOs.CategoryDto.ResponseCategoryDto>

@{
    ViewData["Title"] = "Search Categories";
}

<h1 class="mb-4">
    Search Categories
</h1>

<form asp-action="SearchCategories"
      method="get"
      class="mb-4">

    <div class="input-group">

        <input type="text"
               name="name"
               class="form-control"
               placeholder="Enter category name" />

        <button type="submit"
                class="btn btn-primary">

            Search

        </button>

    </div>

</form>

<div class="row g-4">

    @if (Model != null && Model.Any())
    {
        @foreach (var item in Model)
        {
            <div class="col-md-4">

                <div class="card shadow border-0 rounded-4 h-100">

                    <div class="card-body">

                        <h4 class="text-primary">

                            @item.CategoryName

                        </h4>

                        <p>

                            @item.Description

                        </p>

                    </div>

                    <div class="mt-3 d-grid gap-2 p-3">

                        <a asp-action="GetProductsByCategory"
                               asp-route-id="@item.CategoryId"
                               class="btn btn-outline-primary">

                            Products

                        </a>

                        <a asp-action="GetCategoryById"
                               asp-route-id="@item.CategoryId"
                               class="btn btn-outline-dark">

                            Details

                        </a>

                        <a asp-action="EditCategory"
                               asp-route-id="@item.CategoryId"
                               class="btn btn-outline-success">

                            Edit

                        </a>

                    </div>

                </div>

            </div>
        }
    }
    else
    {
        <div class="col-12">

            <div class="alert alert-danger text-center shadow">

                No Results Found

            </div>

        </div>
    }

</div>
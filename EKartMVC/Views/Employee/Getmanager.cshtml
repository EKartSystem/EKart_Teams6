@model IEnumerable<E_Kart_Application.DTOs.EmployeeDto.EmployeeListingDto>

@{
    ViewData["Title"] = "Management Hierarchy";
}

<div class="container-fluid py-4">
    
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold text-dark mb-1">
                <i class="bi bi-diagram-3-fill text-primary me-2"></i>Management Hierarchy
            </h2>
            <p class="text-muted small mb-0">Systematic oversight of corporate leadership and reporting structures.</p>
        </div>
        <a asp-action="Create" class="btn btn-primary rounded-pill px-4 fw-bold shadow-sm">
            <i class="bi bi-plus-lg me-1"></i> Register Leader
        </a>
    </div>

    
    <div class="card border-0 shadow-sm">

        <div class="card-header bg-primary text-white py-3">
            <h6 class="m-0 fw-bold"><i class="bi bi-shield-check me-2"></i>Leadership Registry</h6>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="bg-light">
                        <tr>
                            <th class="ps-4 text-uppercase small fw-bold text-secondary" style="font-size: 0.7rem;">ID</th>
                            <th class="text-uppercase small fw-bold text-secondary" style="font-size: 0.7rem;">Manager Name</th>
                            <th class="text-uppercase small fw-bold text-secondary" style="font-size: 0.7rem;">Designation</th>
                            <th class="text-center text-uppercase small fw-bold text-secondary" style="font-size: 0.7rem;">Status</th>
                            <th class="text-center text-uppercase small fw-bold text-secondary" style="font-size: 0.7rem;">Direct Reports</th>
                            <th class="pe-4 text-end text-uppercase small fw-bold text-secondary" style="font-size: 0.7rem;">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="ps-4 fw-bold text-primary">#@item.EmployeeId</td>
                                <td class="fw-semibold text-dark">@item.FullName</td>
                                <td>
                                    <span class="badge bg-light text-dark border px-2 py-1 fw-semibold">
                                        @item.Title
                                    </span>
                                </td>
                                <td class="text-center">
                                    @if (item.IsManager)
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success-subtle px-2">Active Manager</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-light text-muted border px-2">Individual Contributor</span>
                                    }
                                </td>
                                <td class="text-center">
                                    <div class="fw-bold text-dark">@item.TotalEmployeesUnderManager</div>
                                    <small class="text-muted d-block" style="font-size: 0.65rem;">Staff Count</small>
                                </td>
                                <td class="pe-4 text-end">
                                    <a asp-action="GetEmployeemanager"
                                           asp-route-id="@item.EmployeeId"
                                           class="btn btn-sm btn-outline-info fw-bold px-3 rounded-pill shadow-sm">
                                        <i class="bi bi-eye me-1"></i> View Employees
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
        <div class="card-footer bg-white py-3 border-top-0 border-start border-4 border-primary">
            <p class="text-muted small mb-0">
                <i class="bi bi-info-circle me-1"></i> Data retrieved from secure organizational records.
            </p>
        </div>
    </div>
</div>
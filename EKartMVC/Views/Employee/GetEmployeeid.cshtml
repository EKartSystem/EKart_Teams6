@model E_Kart_Application.DTOs.EmployeeDto.ResponseEmployeeDto

@{
    ViewData["Title"] = "Employee Details";
}

<div class="container-fluid py-4">
    <div class="row">
        <div class="col-12">
            
            <div class="mb-4">
                <h2 class="fw-bold text-dark">
                    <i class="bi bi-person-badge me-2"></i>Employee Details
                </h2>
                <p class="text-muted">View employee information and contact details</p>
            </div>

            
            <div class="card shadow-sm border-0">
                <div class="card-header bg-primary text-white py-3">
                    <h5 class="m-0 fw-bold">
                        <i class="bi bi-person me-2"></i>@Model.FirstName @Model.LastName
                    </h5>
                </div>
                <div class="card-body">
                    <div class="row">
                        
                        <div class="col-md-6">
                            <div class="row mb-3">
                                <div class="col-sm-4">
                                    <label class="fw-bold text-primary">First Name</label>
                                </div>
                                <div class="col-sm-8">
                                    <p class="text-dark">@Model.FirstName</p>
                                </div>
                            </div>
                            <div class="row mb-3">
                                <div class="col-sm-4">
                                    <label class="fw-bold text-primary">Last Name</label>
                                </div>
                                <div class="col-sm-8">
                                    <p class="text-dark">@Model.LastName</p>
                                </div>
                            </div>
                            <div class="row mb-3">
                                <div class="col-sm-4">
                                    <label class="fw-bold text-primary">Title</label>
                                </div>
                                <div class="col-sm-8">
                                    <p class="text-dark">@Model.Title</p>
                                </div>
                            </div>
                            <div class="row mb-3">
                                <div class="col-sm-4">
                                    <label class="fw-bold text-primary">City</label>
                                </div>
                                <div class="col-sm-8">
                                    <p class="text-dark">@Model.City</p>
                                </div>
                            </div>
                        </div>

                        
                        <div class="col-md-6">
                            <div class="row mb-3">
                                <div class="col-sm-4">
                                    <label class="fw-bold text-primary">Country</label>
                                </div>
                                <div class="col-sm-8">
                                    <p class="text-dark">@Model.Country</p>
                                </div>
                            </div>
                            <div class="row mb-3">
                                <div class="col-sm-4">
                                    <label class="fw-bold text-primary">Phone</label>
                                </div>
                                <div class="col-sm-8">
                                    <p class="text-dark">
                                        @if (!string.IsNullOrEmpty(Model.HomePhone))
                                        {
                                            <a href="tel:@Model.HomePhone" class="text-decoration-none">
                                                <i class="bi bi-telephone me-1"></i>@Model.HomePhone
                                            </a>
                                        }
                                        else
                                        {
                                            <span class="text-muted">N/A</span>
                                        }
                                    </p>
                                </div>
                            </div>
                            <div class="row mb-3">
                                <div class="col-sm-4">
                                    <label class="fw-bold text-primary">Reports To</label>
                                </div>
                                <div class="col-sm-8">
                                    <p class="text-dark">
                                        @if (Model.ReportsTo.HasValue && Model.ReportsTo > 0)
                                        {
                                            <span>Manager ID: @Model.ReportsTo</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">No Manager</span>
                                        }
                                    </p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            
            <div class="mt-4">
                <a asp-action="GetEmployeeall" class="btn btn-outline-secondary btn-sm">Back to List</a>
                <a asp-action="Edit" asp-route-id="@ViewBag.EmployeeId" class="btn btn-outline-primary btn-sm">Edit</a>
            </div>
        </div>
    </div>
</div>

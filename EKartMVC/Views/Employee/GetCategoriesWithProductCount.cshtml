@model IEnumerable<E_Kart_Application.DTOs.CategoryDto.CategoryDto>

@{
    ViewData["Title"] = "Category Statistics";
}

<div class="container-fluid py-4">
    
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold text-dark mb-1">
                <i class="bi bi-bar-chart-line text-primary me-2"></i>Inventory Distribution
            </h2>
            <p class="text-muted small mb-0">Analysis of product counts across all defined categories.</p>
        </div>
        <a asp-action="GetCategories" class="btn btn-outline-secondary rounded-pill px-4 fw-semibold shadow-sm">
            <i class="bi bi-arrow-left me-1"></i> Back to Categories
        </a>
    </div>

    
    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="card border-0 shadow-sm bg-light py-2 px-3">
                <div class="small text-muted text-uppercase fw-bold">Total Categories</div>
                <div class="h5 mb-0 fw-bold">@Model.Count()</div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow-sm bg-light py-2 px-3">
                <div class="small text-muted text-uppercase fw-bold">Total Active Products</div>
                <div class="h5 mb-0 fw-bold text-primary">@Model.Sum(x => x.ProductCount)</div>
            </div>
        </div>
    </div>

    
    <div class="card shadow-sm border-0">
        <div class="card-header bg-primary text-white py-3">
            <h6 class="m-0 fw-bold"><i class="bi bi-table me-2"></i>Product Count Report</h6>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light text-secondary small text-uppercase fw-bold">
                        <tr>
                            <th class="ps-4">Category ID</th>
                            <th>Category Name</th>
                            <th>Description</th>
                            <th class="text-center pe-4">Product Count</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="ps-4 fw-bold">#@item.CategoryId</td>
                                <td class="fw-bold text-dark">@item.CategoryName</td>
                                <td class="text-muted small">
                                    @(string.IsNullOrWhiteSpace(item.Description) ? "No description available." : item.Description)
                                </td>
                                <td class="text-center pe-4">
                                    @if (item.ProductCount > 0)
                                    {
                                        <span class="badge bg-primary-subtle text-primary rounded-pill px-3 py-2 fw-bold">
                                            @item.ProductCount Units
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-light text-muted rounded-pill px-3 py-2 border">
                                            Empty
                                        </span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
        <div class="card-footer bg-white py-3 border-top-0">
            <p class="text-muted small mb-0">
                <i class="bi bi-info-circle me-1"></i> Data generated from current live inventory levels in the <strong>E_Kart_Application</strong>.
            </p>
        </div>
    </div>
</div>
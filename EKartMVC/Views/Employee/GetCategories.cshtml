@model IEnumerable<E_Kart_Application.DTOs.CategoryDto.ResponseCategoryDto>

@{
    ViewData["Title"] = "Category Management";
}

<div class="container-fluid py-4">
    
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold text-dark mb-1">
                <i class="bi bi-tags text-primary me-2"></i>Category Management
            </h2>
            <p class="text-muted small mb-0">Organize and classify products within the inventory system.</p>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="GetCategoriesWithProductCount" class="btn btn-outline-dark rounded-pill px-3 fw-semibold shadow-sm">
                <i class="bi bi-bar-chart me-1"></i> Product Count
            </a>

            <a asp-action="AddCategory" class="btn btn-primary rounded-pill px-4 fw-bold shadow-sm">
                <i class="bi bi-plus-lg me-1"></i> Add Category
            </a>
        </div>
    </div>

    <div class="row mb-5">
        <div class="col-12 col-md-6 col-lg-4">
            <form asp-action="SearchCategory" method="get" class="input-group shadow-sm">
                <input type="text" name="name" class="form-control border-0" placeholder="Search by category name..." />
                <button type="submit" class="btn btn-primary px-4">
                    <i class="bi bi-search"></i>Search
                </button>
            </form>
        </div>
    </div>

    
    <div class="row g-4">
        @foreach (var item in Model)
        {
            <div class="col-xl-3 col-lg-4 col-md-6">
                <div class="card h-100 shadow-sm border-0 overflow-hidden">
                    
                    <div class="bg-primary py-1"></div>
                    
                    <div class="card-body d-flex flex-column p-4">
                        <div class="d-flex justify-content-between align-items-start mb-3">
                            <h5 class="card-title fw-bold text-dark mb-0">@item.CategoryName</h5>
                            <span class="badge bg-light text-primary border px-2 py-1 small">ID: @item.CategoryId</span>
                        </div>

                        <p class="card-text text-muted small flex-grow-1">
                            @(string.IsNullOrWhiteSpace(item.Description) ? "No description provided for this classification." : item.Description)
                        </p>

                        <div class="mt-4 pt-3 border-top d-grid gap-2">
                            <a asp-action="GetProductsByCategory" asp-route-id="@item.CategoryId" class="btn btn-sm btn-outline-primary rounded-pill fw-semibold">
                                <i class="bi bi-box-seam me-1"></i> View Products
                            </a>
                            
                            <div class="d-flex gap-2">
                                <a asp-action="GetCategoryById" asp-route-id="@item.CategoryId" class="btn btn-sm btn-outline-secondary flex-grow-1 rounded-pill fw-semibold">
                                    Details
                                </a>
                                <a asp-action="EditCategory" asp-route-id="@item.CategoryId" class="btn btn-sm btn-outline-warning flex-grow-1 rounded-pill fw-semibold">
                                    Edit
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>
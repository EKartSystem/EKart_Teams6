@model E_Kart_Application.DTOs.CategoryDto.ResponseCategoryDto

@{
    ViewData["Title"] = "Category Details";
}

<div class="container-fluid py-4">
    <div class="row justify-content-center">
        <div class="col-12 col-md-8 col-lg-6">
            
            
            <nav aria-label="breadcrumb" class="mb-4">
                <ol class="breadcrumb mb-0">
                    <li class="breadcrumb-item"><a asp-action="GetCategories" class="text-decoration-none">Categories</a></li>
                    <li class="breadcrumb-item active" aria-current="page">View Details</li>
                </ol>
            </nav>

            
            <div class="card shadow-sm border-0 overflow-hidden">
                
                <div class="bg-primary py-2"></div>
                
                <div class="card-body p-4 p-md-5">
                    <div class="d-flex align-items-center mb-4">
                        <div class="bg-primary-subtle p-3 rounded-3 me-3">
                            <i class="bi bi-tag-fill text-primary fs-3"></i>
                        </div>
                        <div>
                            <h2 class="fw-bold text-dark mb-1">@Model.CategoryName</h2>
                            <span class="badge bg-light text-secondary border">Category ID: #@ViewContext.RouteData.Values["id"]</span>
                        </div>
                    </div>

                    <div class="mb-5">
                        <label class="form-label fw-semibold text-secondary small text-uppercase">Classification Description</label>
                        <div class="p-3 bg-light rounded-3 text-dark shadow-sm italic">
                            @(string.IsNullOrWhiteSpace(Model.Description) ? "No formal description has been provided for this category." : Model.Description)
                        </div>
                    </div>

                    
                    <div class="d-flex justify-content-between align-items-center border-top pt-4">
                        <a asp-action="GetCategories" class="btn btn-outline-secondary rounded-pill px-4 fw-semibold">
                            <i class="bi bi-arrow-left me-1"></i> Back to List
                        </a>
                        <div class="d-flex gap-2">
                            <a asp-action="EditCategory" asp-route-id="@ViewContext.RouteData.Values["id"]" class="btn btn-outline-warning rounded-pill px-4 fw-semibold">
                                <i class="bi bi-pencil-square me-1"></i> Edit
                            </a>
                            <a asp-action="GetProductsByCategory" asp-route-id="@ViewContext.RouteData.Values["id"]" class="btn btn-primary rounded-pill px-4 fw-bold shadow-sm">
                                <i class="bi bi-box-seam me-1"></i> View Products
                            </a>
                        </div>
                    </div>
                </div>
            </div>

            
            <div class="mt-4 text-center">
                <p class="text-muted x-small">
                    <i class="bi bi-shield-check me-1"></i> Categorization data managed via <strong>E_Kart_Application</strong> Admin Portal.
                </p>
            </div>

        </div>
    </div>
</div>
@model IEnumerable<E_Kart_Application.DTOs.EmployeeDto.EmployeeListingDto>

@{
    ViewData["Title"] = "Employee Management";
}

<div class="container-fluid py-4">
    
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold text-dark mb-1">
                <i class="bi bi-people-fill text-primary me-2"></i>Employee Management
            </h2>
            <p class="text-muted small mb-0">Oversee staff roles, organizational hierarchy, and regional assignments.</p>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="Getmanager" class="btn btn-outline-dark rounded-pill px-3 fw-semibold shadow-sm">
                <i class="bi bi-person-badge me-1"></i> View Managers
            </a>
            <a asp-action="Create" class="btn btn-primary rounded-pill px-4 fw-bold shadow-sm">
                <i class="bi bi-person-plus-fill me-1"></i> Add Employee
            </a>
        </div>
    </div>

    
    <div class="card shadow-sm border-0">
        <div class="card-header bg-primary text-white py-3">
            <h6 class="m-0 fw-bold"><i class="bi bi-list-ul me-2"></i>Corporate Directory</h6>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light text-secondary small text-uppercase fw-bold">
                        <tr>
                            <th class="ps-4">@Html.DisplayNameFor(model => model.EmployeeId)</th>
                            <th>@Html.DisplayNameFor(model => model.FullName)</th>
                            <th>@Html.DisplayNameFor(model => model.Title)</th>
                            <th class="text-center">@Html.DisplayNameFor(model => model.IsManager)</th>
                            <th class="text-center">Reports</th>
                            <th class="text-center pe-4">Operations</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="ps-4 fw-bold">#@item.EmployeeId</td>
                                <td class="fw-bold text-dark">@item.FullName</td>
                                <td>
                                    <span class="badge bg-light text-primary border px-2 py-2 fw-semibold">
                                        @item.Title
                                    </span>
                                </td>
                                <td class="text-center">
                                    @if (item.IsManager)
                                    {
                                        <span class="badge bg-success-subtle text-success rounded-pill px-3">Yes</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-light text-muted rounded-pill px-3">No</span>
                                    }
                                </td>
                                <td class="text-center fw-bold text-secondary">
                                    @(item.IsManager ? item.TotalEmployeesUnderManager : "—")
                                </td>
                                <td class="text-center pe-4">
                                    <div class="btn-group shadow-sm">
                                        <a asp-action="GetEmployeeid" asp-route-id="@item.EmployeeId"
                                               class="btn btn-sm btn-outline-info fw-bold" title="Details">
                                            <i class="bi bi-eye me-1"></i> Details
                                        </a>
                                        <a asp-action="Edit" asp-route-id="@item.EmployeeId"
                                               class="btn btn-sm btn-outline-success fw-bold" title="Edit Profile">
                                            <i class="bi bi-pencil me-1"></i> Edit
                                        </a>
                                        <a asp-action="Updatetitle" asp-route-id="@item.EmployeeId"
                                               class="btn btn-sm btn-outline-warning fw-bold" title="Update Title">
                                            <i class="bi bi-briefcase me-1"></i> Title
                                        </a>
                                        <a asp-action="GetTerritory" asp-route-id="@item.EmployeeId"
                                               class="btn btn-sm btn-outline-dark fw-bold" title="Territories">
                                            <i class="bi bi-geo-alt me-1"></i> Territories
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
        <div class="card-footer bg-white py-3 border-top-0">
            <p class="text-muted small mb-0">Showing system employees based on current Northwind organizational hierarchy.</p>
        </div>
    </div>
</div>
@using E_Kart_Application.DTOs.Customersdto
@model CustomerLogin

@{
    ViewData["Title"] = "Secure Login";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-12 col-sm-10 col-md-8 col-lg-5">

            <div class="text-center mb-4">
                <div class="d-inline-flex align-items-center justify-content-center bg-primary text-white rounded-circle shadow-sm mb-3" style="width: 60px; height: 60px;">
                    <i class="bi bi-shield-lock-fill fs-3"></i>
                </div>
                <h2 class="fw-bold text-dark">Welcome to EKart</h2>
                <p class="text-muted small">Please enter your credentials to access your account.</p>
            </div>

            <div class="card shadow border-0 overflow-hidden">
                <div class="card-header bg-primary py-1"></div> 
                <div class="card-body p-4 p-md-5">
                    
                    <h3 class="fw-bold text-center mb-4">Secure Login</h3>

                    <form asp-action="Login" method="post">
                        @Html.AntiForgeryToken()

                        <div class="mb-3">
                            <label asp-for="ContactName" class="form-label fw-semibold text-secondary small text-uppercase">Contact Name</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-end-0"><i class="bi bi-person text-muted"></i></span>
                                <input asp-for="ContactName" class="form-control border-start-0 ps-0" placeholder="Username" required />
                            </div>
                            <span asp-validation-for="ContactName" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Password" class="form-label fw-semibold text-secondary small text-uppercase">Password</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-end-0"><i class="bi bi-key text-muted"></i></span>
                                <input asp-for="Password" type="password" class="form-control border-start-0 ps-0" placeholder="••••••••" required />
                            </div>
                            <span asp-validation-for="Password" class="text-danger small"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="Role" class="form-label fw-semibold text-secondary small text-uppercase">Access Level</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-end-0"><i class="bi bi-layers text-muted"></i></span>
                                <select asp-for="Role" class="form-select border-start-0 ps-0">
                                    <option value="Customer">Customer</option>
                                    <option value="Admin">Admin</option>
                                </select>
                            </div>
                        </div>

                        <button type="submit" class="btn btn-primary w-100 py-2 fw-bold shadow-sm rounded-pill mb-3">
                            Login to Account
                        </button>

                    </form>

                    @if (ViewBag.Error != null)
                    {
                        <div class="alert alert-danger border-0 small shadow-sm py-2 text-center" role="alert">
                            <i class="bi bi-exclamation-circle me-2"></i> @ViewBag.Error
                        </div>
                    }

                    <hr class="my-4 opacity-25">

                    <div class="text-center">
                        <span class="text-muted small">New to EKart?</span>
                        <a asp-action="Register" class="text-primary fw-bold text-decoration-none ms-1 small">Create Account</a>
                    </div>

                </div>
            </div>

            <div class="text-center mt-4">
                <p class="text-muted x-small">© 2026 EKart Application. All rights reserved.</p>
            </div>

        </div>
    </div>
</div>
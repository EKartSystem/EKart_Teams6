@model E_Kart_Application.DTOs.ProductsDTO.ProductDetailsDto

@{
    ViewData["Title"] = "Technical Specifications";
}

<div class="container-fluid py-4">
    
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold text-dark mb-1">
                <i class="bi bi-info-square-fill text-primary me-2"></i>Technical Specifications
            </h2>
            <p class="text-muted small mb-0">Detailed inventory data and supply chain logistics for the selected asset.</p>
        </div>
        <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4 fw-bold shadow-sm">
            <i class="bi bi-arrow-left me-1"></i> Back to Catalog
        </a>
    </div>

    <div class="card border-0 shadow-sm overflow-hidden">
        
        <div class="card-header bg-primary text-white py-3">
            <h6 class="m-0 fw-bold"><i class="bi bi-shield-lock me-2"></i>Product Master Record</h6>
        </div>
        
        <div class="row g-0">
            
            <div class="col-md-4 bg-light border-end d-flex flex-column p-5 text-center">
                <div class="mb-auto">
                    <label class="text-uppercase small fw-bold text-secondary d-block mb-2">Unit Price</label>
                    <h1 class="display-5 fw-bold text-primary mb-0">@Model.UnitPrice?.ToString("C")</h1>
                    <p class="text-muted small">Current System List Price</p>
                </div>
                
                <div class="mt-4 pt-4 border-top">
                    <div class="d-grid gap-2">
                        <span class="badge @(Model.IsInStock ? "bg-success-subtle text-success border border-success" : "bg-danger-subtle text-danger border border-danger") py-2 fs-6 fw-bold">
                            <i class="bi bi-box-seam me-2"></i>@(Model.IsInStock ? "LOGISTICS: AVAILABLE" : "OUT OF STOCK")
                        </span>
                        @if (Model.Discontinued)
                        {
                            <span class="badge bg-dark text-white py-2 fw-bold">
                                <i class="bi bi-exclamation-octagon me-2"></i>DISCONTINUED
                            </span>
                        }
                    </div>
                </div>
            </div>

            
            <div class="col-md-8 bg-white p-5">
                <div class="mb-4">
                    <h2 class="fw-bold text-dark mb-1">@Model.ProductName</h2>
                    <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-3 py-2 fw-bold text-uppercase" style="font-size: 0.7rem;">
                        @Model.CategoryName
                    </span>
                </div>

                <p class="text-secondary small mb-5 border-start border-4 border-light ps-3 italic">
                    @Model.CategoryDescription
                </p>

                <div class="row g-4 mb-5">
                    <div class="col-sm-6">
                        <label class="text-uppercase small fw-bold text-secondary d-block mb-1" style="font-size: 0.7rem;">Supplier</label>
                        <p class="mb-0 text-dark fw-bold">@Model.SupplierCompanyName</p>
                        <small class="text-muted"><i class="bi bi-geo-alt me-1"></i>@Model.SupplierCountry</small>
                    </div>
                    <div class="col-sm-6">
                        <label class="text-uppercase small fw-bold text-secondary d-block mb-1" style="font-size: 0.7rem;">Quantity Per Unit</label>
                        <p class="mb-0 text-dark fw-bold">@Model.QuantityPerUnit</p>
                        <small class="text-muted">Standard Distribution Unit</small>
                    </div>
                </div>

                
                <div class="row g-0 p-0 bg-white rounded-3 border overflow-hidden shadow-sm">
                    <div class="col-4 text-center border-end py-3 bg-light-subtle">
                        <span class="d-block h4 mb-0 fw-bold text-dark">@Model.UnitsInStock</span>
                        <small class="text-secondary text-uppercase fw-bold" style="font-size: 0.6rem;">Units In Stock</small>
                    </div>
                    <div class="col-4 text-center border-end py-3">
                        <span class="d-block h4 mb-0 fw-bold text-dark">@Model.UnitsOnOrder</span>
                        <small class="text-secondary text-uppercase fw-bold" style="font-size: 0.6rem;">Units On Order</small>
                    </div>
                    <div class="col-4 text-center py-3 bg-light-subtle">
                        <span class="d-block h4 mb-0 fw-bold text-primary">@Model.ReorderLevel</span>
                        <small class="text-secondary text-uppercase fw-bold" style="font-size: 0.6rem;">Reorder Level</small>
                    </div>
                </div>
                
                <div class="mt-5 d-flex justify-content-end gap-3 align-items-center pt-4 border-top">
                    <a asp-controller="Cart"
                           asp-action="AddToCart"
                           asp-route-productId="@Model.ProductId"
                           asp-route-quantity="1"
                           class="btn btn-primary px-5 rounded-pill fw-bold shadow-sm">
                        <i class="bi bi-cart-plus me-2"></i>Initialize Purchase
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
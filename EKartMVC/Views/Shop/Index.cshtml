@using Microsoft.AspNetCore.Http
@model IEnumerable<E_Kart_Application.DTOs.ProductsDTO.ProductListingDto>

@{
    ViewData["Title"] = "Product Catalog";
    var token = Context.Session.GetString("jwt");
    var isAdmin = Context.Session.GetString("IsAdmin");
    
    // Controller se bheje gaye values
    int currentPage = ViewBag.CurrentPage ?? 1;
    int totalPages = ViewBag.TotalPages ?? 1;
    string currentSearch = ViewBag.Name;
    bool? isExpensive = ViewBag.ShowExpensive;
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h3 class="fw-bold text-dark">Product Catalog</h3>
        @if (!string.IsNullOrEmpty(token) && isAdmin == "true")
        {
            <a asp-action="Create" class="btn btn-success rounded-pill px-4 shadow-sm">
                <i class="bi bi-plus-lg"></i> Create New Product
            </a>
        }
    </div>

    @* Search Form Section *@
    <div class="card border-0 shadow-sm mb-4 bg-light">
        <div class="card-body">
            <form asp-action="Index" method="get" class="row g-2">
                <div class="col-md-8">
                    <input type="text" name="name" class="form-control" placeholder="Search by product name..." value="@currentSearch" />
                </div>
                <div class="col-md-4 d-flex gap-2">
                    <button type="submit" class="btn btn-primary flex-grow-1">Search</button>
                    <a asp-action="Index" class="btn btn-outline-secondary">Clear</a>
                    <button type="submit" name="showExpensive" value="true" class="btn btn-warning text-white">Top Expensive</button>
                </div>
            </form>
        </div>
    </div>

    @* Products Grid *@
    <div class="row row-cols-1 row-cols-md-4 g-4">
        @if (Model != null && Model.Any())
        {
            foreach (var item in Model)
            {
                <div class="col">
                    <div class="card h-100 border-0 shadow-sm rounded-3 overflow-hidden">
                        <div class="card-body d-flex flex-column">
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <h6 class="card-title fw-bold mb-0">
                                    <a asp-action="Details" asp-route-id="@item.ProductId" class="text-decoration-none text-dark">
                                        @item.ProductName
                                    </a>
                                </h6>
                                @if (!item.IsInStock)
                                {
                                    <span class="badge rounded-pill bg-danger" style="font-size: 0.65rem;">Out of Stock</span>
                                }
                            </div>
                            <p class="card-text small text-muted mb-3">@item.CategoryName</p>
                            <div class="mt-auto">
                                <div class="d-flex justify-content-between align-items-center mb-2">
                                    <span class="fw-bold text-primary fs-5">@item.UnitPrice?.ToString("C")</span>
                                </div>
                                <div class="btn-group w-100">
                                    @if (!string.IsNullOrEmpty(token) && isAdmin == "true")
                                    {
                                        <a asp-action="Edit" asp-route-id="@item.ProductId" class="btn btn-sm btn-outline-primary">Edit</a>
                                    }
                                    <a asp-action="Details" asp-route-id="@item.ProductId" class="btn btn-sm btn-dark">View Details</a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="col-12 text-center py-5">
                <p class="text-muted">No products found.</p>
            </div>
        }
    </div>

    @* --- PAGINATION BUTTONS --- *@
    @if (totalPages > 1)
    {
        <div class="d-flex justify-content-center mt-5 mb-4">
            <nav aria-label="Product Page Navigation">
                <ul class="pagination shadow-sm">
                    @* Previous Button *@
                    <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                        <a class="page-link" asp-action="Index"
                           asp-route-pageNumber="@(currentPage - 1)"
                           asp-route-name="@currentSearch"
                           asp-route-showExpensive="@isExpensive">Previous</a>
                    </li>

                    @* Page Numbers *@
                    @for (int i = 1; i <= totalPages; i++)
                    {
                        <li class="page-item @(i == currentPage ? "active" : "")">
                            <a class="page-link" asp-action="Index"
                               asp-route-pageNumber="@i"
                               asp-route-name="@currentSearch"
                               asp-route-showExpensive="@isExpensive">@i</a>
                        </li>
                    }

                    @* Next Button *@
                    <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                        <a class="page-link" asp-action="Index"
                           asp-route-pageNumber="@(currentPage + 1)"
                           asp-route-name="@currentSearch"
                           asp-route-showExpensive="@isExpensive">Next</a>
                    </li>
                </ul>
            </nav>
        </div>
    }
</div>
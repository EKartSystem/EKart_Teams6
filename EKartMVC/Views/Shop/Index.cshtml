@using Microsoft.AspNetCore.Http
@model IEnumerable<E_Kart_Application.DTOs.ProductsDTO.ProductListingDto>

@{
    ViewData["Title"] = "Inventory Management";
    var token = Context.Session.GetString("jwt");
    var isAdmin = Context.Session.GetString("IsAdmin");

    int currentPage = ViewBag.CurrentPage ?? 1;
    int totalPages = ViewBag.TotalPages ?? 1;
    string currentSearch = ViewBag.Name;
    bool? isExpensive = ViewBag.ShowExpensive;
}

<div class="container-fluid py-4">
    
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold text-dark mb-1">
                <i class="bi bi-box-seam-fill text-primary me-2"></i>Inventory Management
            </h2>
            <p class="text-muted small mb-0">Systematic oversight of product classifications and stock availability.</p>
        </div>
        <div class="d-flex gap-2">
            @if (!string.IsNullOrEmpty(token) && isAdmin != "true")
            {
                <a asp-controller="Order" asp-action="MyOrders" class="btn btn-outline-primary rounded-pill px-4 fw-bold shadow-sm">
                    <i class="bi bi-clock-history me-1"></i> Order History
                </a>
            }
            @if (!string.IsNullOrEmpty(token) && isAdmin == "true")
            {
                <a asp-action="Create" class="btn btn-primary rounded-pill px-4 fw-bold shadow-sm">
                    <i class="bi bi-plus-lg me-1"></i> Register Product
                </a>
            }
        </div>
    </div>

    <div class="card border-0 shadow-sm mb-5">
        <div class="card-header bg-primary text-white py-3">
            <h6 class="m-0 fw-bold"><i class="bi bi-filter-left me-2"></i>Catalog Filters</h6>
        </div>
        <div class="card-body bg-light-subtle p-4">
            <form asp-action="Index" method="get" class="row g-3">
                <div class="col-md-7">
                    <div class="input-group border rounded-3 bg-white">
                        <span class="input-group-text bg-transparent border-0"><i
                            class="bi bi-search text-muted"></i></span>
                            <input type="text" name="name" class="form-control border-0 shadow-none"
                                   placeholder="Search by product name..." value="@currentSearch" />
                        </div>
                    </div>
                    <div class="col-md-5 d-flex gap-2">
                        
                        <button type="submit" class="btn btn-primary flex-grow-1 fw-bold shadow-sm">
                            <i class="bi bi-search me-1"></i> Search
                        </button>
    
                        
                        <button type="submit" name="showExpensive" value="true"
                                class="btn btn-outline-warning fw-bold px-3 shadow-sm" title="High-Value Assets">
                            <i class="bi bi-gem me-1"></i> Top Expensive
                        </button>

                        
                        <a asp-action="Index" class="btn btn-outline-secondary px-3 shadow-sm" title="Reset Filters">
                            <i class="bi bi-arrow-counterclockwise me-1"></i> Clear
                        </a>
                    </div>
                </form>
            </div>
        </div>

        <div class="row g-4">
            @if (Model != null && Model.Any())
            {
                foreach (var item in Model)
                {
                    <div class="col-12 col-sm-6 col-lg-4 col-xl-3">
                        <div class="card h-100 border-0 shadow-sm border-top border-primary border-4">
                            <div class="card-body d-flex flex-column p-4">
                                
                                <div class="d-flex justify-content-between align-items-start mb-3">
                                    <span
                                        class="badge bg-light text-primary border border-primary-subtle px-2 py-1 small fw-bold text-uppercase">
                                        @item.CategoryName
                                    </span>
                                    @if (!item.IsInStock)
                                    {
                                        <span class="badge rounded-pill bg-danger-subtle text-danger border border-danger px-2 py-1"
                                              style="font-size: 0.6rem; letter-spacing: 0.5px;">UNAVAILABLE</span>
                                    }
                                </div>

                                <h6 class="card-title fw-bold text-dark mb-4">
                                    <a asp-action="Details" asp-route-id="@item.ProductId"
                                           class="text-decoration-none text-dark link-primary">
                                        @item.ProductName
                                    </a>
                                </h6>

                                
                                <div class="mt-auto pt-3 border-top border-light">
                                    <div class="d-flex justify-content-between align-items-center mb-3">
                                        <span class="text-secondary small fw-bold text-uppercase" style="font-size: 0.7rem;">Unit
                                            Price</span>
                                            <span class="h5 fw-bold text-primary mb-0">@item.UnitPrice?.ToString("C")</span>
                                        </div>
                                
                                        <div class="btn-group w-100 shadow-sm">
                                            <a asp-action="Details" asp-route-id="@item.ProductId" class="btn btn-sm btn-outline-primary py-2">
                                                <i class="bi bi-file-earmark-text me-1"></i> Details
                                            </a>
                                            @if (!string.IsNullOrEmpty(token) && isAdmin == "true")
                                            {
                                                <a asp-action="Edit" asp-route-id="@item.ProductId"
                                                       class="btn btn-sm btn-outline-primary py-2 px-3 fw-bold shadow-sm"
                                                       title="Modify Record">
                                                    <i class="bi bi-pencil-square me-1"></i> Edit
                                                </a>
                                            }
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                }
            </div>

            @if (totalPages > 1)
            {
                <div class="d-flex justify-content-center mt-5 mb-4">
                    <nav>
                        <ul class="pagination pagination-sm shadow-sm">
                            <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                                <a class="page-link fw-bold px-3 py-2" asp-action="Index" asp-route-pageNumber="1"
                                   asp-route-name="@currentSearch">&laquo;&laquo;</a>
                            </li>
                            <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                                <a class="page-link fw-bold px-3 py-2" asp-action="Index" asp-route-pageNumber="@(currentPage - 1)"
                                   asp-route-name="@currentSearch">&laquo;</a>
                            </li>
                            <li class="page-item disabled">
                                <span class="page-link fw-bold">@currentPage of @totalPages</span>
                            </li>
                            <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                                <a class="page-link fw-bold px-3 py-2" asp-action="Index" asp-route-pageNumber="@(currentPage + 1)"
                                   asp-route-name="@currentSearch">&raquo;</a>
                            </li>
                            <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                                <a class="page-link fw-bold px-3 py-2" asp-action="Index" asp-route-pageNumber="@totalPages"
                                   asp-route-name="@currentSearch">&raquo;&raquo;</a>
                            </li>
                        </ul>
                    </nav>
                </div>
            }
        </div>
@using E_Kart_Application.DTOs.LocationDTO
@model IEnumerable<RegionDto>

@{
    ViewData["Title"] = "Regional Logistics";
    var territories = ViewBag.Territories as IEnumerable<TerritoryDto>;
    var selectedId = ViewBag.SelectedRegionId as int?;
}

<div class="container-fluid py-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold text-dark mb-1">
                <i class="bi bi-geo-alt-fill text-primary me-2"></i>Regional Logistics
            </h2>
            <p class="text-muted small mb-0">Manage geographical distribution and territory assignments for the EKart sales network.</p>
        </div>
        <a asp-action="Create" class="btn btn-primary rounded-pill px-4 fw-bold shadow-sm">
            <i class="bi bi-plus-lg me-1"></i> Add New Territory
        </a>
    </div>

    <div class="row g-4">
        
        <div class="col-12 col-lg-3">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-primary text-white py-3">
                    <h6 class="m-0 fw-bold"><i class="bi bi-map me-2"></i>Select Region</h6>
                </div>
                <div class="list-group list-group-flush small">
                    @if (Model != null)
                    {
                        foreach (var region in Model)
                        {
                            <a asp-action="Index"
                                   asp-route-regionId="@region.RegionId"
                                   class="list-group-item list-group-item-action py-3 border-0 @(selectedId == region.RegionId ? "bg-primary-subtle border-start border-primary border-4 fw-bold text-primary" : "text-secondary")">
                                <i class="bi bi-chevron-right me-2 @(selectedId == region.RegionId ? "" : "text-muted")"></i>
                                @region.RegionDescription
                            </a>
                        }
                    }
                </div>
            </div>
        </div>

        
        <div class="col-12 col-lg-9">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-header bg-white py-3">
                    <h6 class="m-0 fw-bold text-primary">
                        @if (selectedId != null)
                        {
                            <i class="bi bi-building-check me-2"></i><span>Territories for Region #@selectedId</span>
                        }
                        else
                        {
                            <i class="bi bi-info-circle me-2"></i><span>Territory Directory</span>
                        }
                    </h6>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light text-secondary small text-uppercase fw-bold">
                                <tr>
                                    <th class="ps-4" style="width: 25%">Identity ID</th>
                                    <th style="width: 55%">Geographical Description</th>
                                    <th style="width: 20%" class="text-center pe-4">Operations</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (territories != null && territories.Any())
                                {
                                    foreach (var t in territories)
                                    {
                                        <tr>
                                            <td class="ps-4">
                                                <span class="badge bg-light text-dark border fw-normal">@t.TerritoryId</span>
                                            </td>
                                            <td class="fw-semibold text-dark">@t.TerritoryDescription</td>
                                            <td class="text-center pe-4">
                                                <div class="btn-group shadow-sm">
                                                    <a asp-action="Edit" asp-route-id="@t.TerritoryId"
                                                           class="btn btn-sm btn-outline-warning fw-bold" title="Modify Territory">
                                                        <i class="bi bi-pencil me-1"></i> Edit
                                                    </a>
                                                    <a asp-action="Details" asp-route-id="@t.TerritoryId"
                                                           class="btn btn-sm btn-outline-dark fw-bold" title="Detailed View">
                                                        <i class="bi bi-eye me-1"></i> Details
                                                    </a>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="3" class="text-center py-5">
                                            <div class="py-4">
                                                @if (selectedId == null)
                                                {
                                                    <i class="bi bi-arrow-left-circle display-4 text-muted mb-3 d-block"></i>
                                                    <p class="text-muted mb-0 fw-semibold">Selection Required</p>
                                                    <span class="text-muted small">Please choose a regional district from the navigation panel.</span>
                                                }
                                                else
                                                {
                                                    <i class="bi bi-geo-alt display-4 text-muted mb-3 d-block"></i>
                                                    <p class="text-muted mb-0 fw-semibold">No Regional Data Found</p>
                                                    <span class="text-muted small">This specific region does not currently have assigned territories.</span>
                                                }
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
                <div class="card-footer bg-white py-3 border-top-0">
                    <p class="text-muted small mb-0">
                        <i class="bi bi-info-circle me-1"></i> Geographical data is managed according to global Northwind regional standards.
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>

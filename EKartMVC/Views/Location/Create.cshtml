@model E_Kart_Application.DTOs.LocationDTO.TerritoryDto

@{
    ViewData["Title"] = "Add New Territory";
}

<div class="container mt-5">
    <div class="card border-0 shadow-sm rounded-4 mx-auto" style="max-width: 600px;">
        <div class="card-header bg-primary text-white p-4 rounded-top-4">
            <h4 class="mb-0 fw-bold"><i class="bi bi-geo-alt"></i> Add New Territory</h4>
        </div>
        <div class="card-body p-4">
            <form asp-action="Create" method="post">
                <div class="row g-3">
                    <div class="col-12">
                        <label asp-for="TerritoryId" class="form-label small fw-bold">Territory ID (Manual Code)</label>
                        <input asp-for="TerritoryId" class="form-control border-primary-subtle" placeholder="e.g., 01581" required />
                    </div>

                    <div class="col-12">
                        <label asp-for="TerritoryDescription" class="form-label small fw-bold">Territory Description</label>
                        <input asp-for="TerritoryDescription" class="form-control" placeholder="Enter name (e.g., Westboro)" required />
                    </div>

                    <div class="col-12">
                        <label asp-for="RegionId" class="form-label small fw-bold">Region</label>
                        <select asp-for="RegionId" class="form-select"
                                asp-items="@(new SelectList(ViewBag.Regions, "RegionId", "RegionDescription"))">
                            <option value="">-- Select Parent Region --</option>
                        </select>
                    </div>

                    <div class="col-12 mt-4 d-flex justify-content-between align-items-center">
                        <a asp-action="Index" class="btn btn-link text-muted px-0">Cancel</a>
                        <button type="submit" class="btn btn-primary px-5 rounded-pill shadow-sm">Save Territory</button>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>
@model EKartMVC.Models.SupplierViewModel
@{
    ViewData["Title"] = "Supplier Details";
    var products = ViewBag.Products as List<System.Text.Json.JsonElement> ?? new();
}

<div class="container mt-4">
    <div class="row g-4">
        <div class="col-md-5">
            <div class="card shadow-sm h-100">
                <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center">
                    <h5 class="mb-0">🏭 Supplier Details</h5>
                    <span class="badge bg-secondary">ID: @Model.SupplierId</span>
                </div>
                <div class="card-body">
                    <dl class="row">
                        <dt class="col-sm-5">Company Name</dt>
                        <dd class="col-sm-7">@Model.CompanyName</dd>

                        <dt class="col-sm-5">Contact Name</dt>
                        <dd class="col-sm-7">@(Model.ContactName ?? "—")</dd>

                        <dt class="col-sm-5">Contact Title</dt>
                        <dd class="col-sm-7">@(Model.ContactTitle ?? "—")</dd>

                        <dt class="col-sm-5">Phone</dt>
                        <dd class="col-sm-7">@(Model.Phone ?? "—")</dd>

                        <dt class="col-sm-5">Fax</dt>
                        <dd class="col-sm-7">@(Model.Fax ?? "—")</dd>

                        <dt class="col-sm-5">Address</dt>
                        <dd class="col-sm-7">@(Model.Address ?? "—")</dd>

                        <dt class="col-sm-5">City</dt>
                        <dd class="col-sm-7">@(Model.City ?? "—")</dd>

                        <dt class="col-sm-5">Region</dt>
                        <dd class="col-sm-7">@(Model.Region ?? "—")</dd>

                        <dt class="col-sm-5">Postal Code</dt>
                        <dd class="col-sm-7">@(Model.PostalCode ?? "—")</dd>

                        <dt class="col-sm-5">Country</dt>
                        <dd class="col-sm-7">@(Model.Country ?? "—")</dd>

                        <dt class="col-sm-5">Home Page</dt>
                        <dd class="col-sm-7">@(Model.HomePage ?? "—")</dd>
                    </dl>
                </div>
                <div class="card-footer d-flex gap-2">
                    <a asp-action="Edit" asp-route-id="@Model.SupplierId" class="btn btn-warning">Edit</a>
                    <a asp-action="Index" class="btn btn-outline-secondary ms-auto">Back to List</a>
                </div>
            </div>
        </div>

        <div class="col-md-7">
            <div class="card shadow-sm">
                <div class="card-header bg-secondary text-white">
                    <h5 class="mb-0">📦 Products from this Supplier</h5>
                </div>
                <div class="card-body p-0">
                    @if (!products.Any())
                    {
                        <div class="p-3 text-muted">No products found for this supplier.</div>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-sm table-hover mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th>Product Name</th>
                                        <th>Unit Price</th>
                                        <th>In Stock</th>
                                        <th>Discontinued</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var p in products)
                                    {
                                        <tr>
                                            <td>@(p.TryGetProperty("productName", out var pn) ? pn.ToString() : "—")</td>
                                            <td>@(p.TryGetProperty("unitPrice", out var up) && up.ValueKind != System.Text.Json.JsonValueKind.Null ? $"${up}" : "—")</td>
                                            <td>@(p.TryGetProperty("unitsInStock", out var us) ? us.ToString() : "—")</td>
                                            <td>
                                                @{
                                                    var disc = p.TryGetProperty("discontinued", out var d) && d.GetBoolean();
                                                }
                                                @if (disc)
                                                {
                                                    <span class="badge bg-danger">Yes</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-success">No</span>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@model List<EKartMVC.Models.SupplierViewModel>
@{
    ViewData["Title"] = "Supply Chain Management";
}

<div class="container-fluid py-4>
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold text-dark mb-1">
                <i class="bi bi-factory text-primary me-2"></i>Supply Chain Management
            </h2>
            <p class="text-muted small mb-0">Oversee global vendor relations, procurement contacts, and regional logistics.</p>
        </div>
        <a asp-action="Create" class="btn btn-primary rounded-pill px-4 fw-bold shadow-sm">
            <i class="bi bi-plus-lg me-1"></i> Add Supplier
        </a>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-md-5">
            <form asp-action="Search" method="get">
                <div class="input-group shadow-sm">
                    <span class="input-group-text bg-white border-end-0"><i class="bi bi-search text-muted"></i></span>
                    <input type="text" name="name" class="form-control border-start-0 ps-0"
                           placeholder="Search by company name..."
                           value="@(ViewBag.SearchTerm)" />
                    <button class="btn btn-primary px-4" type="submit">Search</button>
                    @if (ViewBag.SearchTerm != null)
                    {
                        <a asp-action="Index" class="btn btn-outline-danger border-start-0">
                            <i class="bi bi-x-lg"></i>Clear
                        </a>
                    }
                </div>
            </form>
        </div>

    </div>

    
    @if (ViewBag.SearchTerm != null || ViewBag.Country != null)
    {
        <div class="alert alert-primary-subtle border-0 py-2 mb-4 shadow-sm d-inline-flex align-items-center">
            <i class="bi bi-info-circle-fill me-2"></i>
            <span class="small">
                Filtering by:
                @if (ViewBag.SearchTerm != null)
                {
                    <span class="fw-bold">Name: "@ViewBag.SearchTerm"</span>
                }
                @if (ViewBag.Country != null)
                {
                    <span class="ms-2 fw-bold">Region: "@ViewBag.Country"</span>
                }
            </span>
        </div>
    }

    
    <div class="card shadow-sm border-0">
        <div class="card-header bg-primary text-white py-3">
            <h6 class="m-0 fw-bold"><i class="bi bi-list-columns-reverse me-2"></i>Authorized Vendor Registry</h6>
        </div>
        <div class="card-body p-0">
            @if (!Model.Any())
            {
                <div class="text-center py-5">
                    <i class="bi bi-search display-4 text-muted mb-3 d-block"></i>
                    <p class="text-muted fw-semibold">No supplier records match your current parameters.</p>
                    <a asp-action="Index" class="btn btn-sm btn-link text-decoration-none">Reset all filters</a>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light text-secondary small text-uppercase fw-bold">
                            <tr>
                                <th class="ps-4">Entity ID</th>
                                <th>Company Name</th>
                                <th>Primary Contact</th>
                                <th>City</th>
                                <th>Country</th>
                                <th>Contact Phone</th>
                                <th class="text-center pe-4">Operations</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var supplier in Model)
                            {
                                <tr>
                                    <td class="ps-4 fw-bold text-dark">#@supplier.SupplierId</td>
                                    <td>
                                        <div class="fw-bold text-dark">@supplier.CompanyName</div>
                                    </td>
                                    <td class="small">@(supplier.ContactName ?? "—")</td>
                                    <td class="small text-muted">@(supplier.City ?? "—")</td>
                                    <td>
                                        <span class="badge bg-light text-primary border px-2 py-1 small">
                                            @(supplier.Country ?? "Global")
                                        </span>
                                    </td>
                                    <td class="small">
                                        <i class="bi bi-telephone text-primary me-1"></i>
                                        @(supplier.Phone ?? "—")
                                    </td>
                                    <td class="text-center pe-4">
                                        <div class="btn-group shadow-sm">
                                            <a asp-action="Details" asp-route-id="@supplier.SupplierId"
                                                   class="btn btn-sm btn-outline-info fw-bold" title="Details">
                                                <i class="bi bi-eye me-1"></i> Details
                                            </a>
                                            <a asp-action="Edit" asp-route-id="@supplier.SupplierId"
                                                   class="btn btn-sm btn-outline-warning fw-bold" title="Modify Record">
                                                <i class="bi bi-pencil-square me-1"></i> Edit
                                            </a>
                                            
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
        <div class="card-footer bg-white py-3 border-top-0">
            <div class="d-flex justify-content-between align-items-center">
                <p class="text-muted small mb-0">
                    <i class="bi bi-info-circle me-1"></i> Total active records: <span class="fw-bold">@Model.Count</span>
                </p>
                <p class="text-muted small mb-0">© 2026 EKart Logistics Portal</p>
            </div>
        </div>
    </div>
</div>
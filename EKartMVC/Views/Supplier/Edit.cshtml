@model EKartMVC.Models.SupplierViewModel
@{
    ViewData["Title"] = "Edit Supplier";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-sm">
                <div class="card-header bg-warning">
                    <h5 class="mb-0">✏️ Edit Supplier — <span class="fw-normal">@Model.CompanyName</span></h5>
                </div>
                <div class="card-body">
                    <form asp-action="Edit" asp-route-id="@Model.SupplierId" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="SupplierId" />
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <h6 class="text-muted fw-semibold mb-3 border-bottom pb-2">Company Information</h6>
                        <div class="row g-3 mb-3">
                            <div class="col-md-6">
                                <label asp-for="CompanyName" class="form-label fw-semibold"></label>
                                <input asp-for="CompanyName" class="form-control" />
                                <span asp-validation-for="CompanyName" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="HomePage" class="form-label fw-semibold"></label>
                                <input asp-for="HomePage" class="form-control" />
                            </div>
                        </div>

                        <h6 class="text-muted fw-semibold mb-3 border-bottom pb-2">Contact Details</h6>
                        <div class="row g-3 mb-3">
                            <div class="col-md-6">
                                <label asp-for="ContactName" class="form-label fw-semibold"></label>
                                <input asp-for="ContactName" class="form-control" />
                            </div>
                            <div class="col-md-6">
                                <label asp-for="ContactTitle" class="form-label fw-semibold"></label>
                                <input asp-for="ContactTitle" class="form-control" />
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Phone" class="form-label fw-semibold"></label>
                                <input asp-for="Phone" class="form-control" />
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Fax" class="form-label fw-semibold"></label>
                                <input asp-for="Fax" class="form-control" />
                            </div>
                        </div>

                        <h6 class="text-muted fw-semibold mb-3 border-bottom pb-2">Address</h6>
                        <div class="row g-3 mb-4">
                            <div class="col-12">
                                <label asp-for="Address" class="form-label fw-semibold"></label>
                                <input asp-for="Address" class="form-control" />
                            </div>
                            <div class="col-md-4">
                                <label asp-for="City" class="form-label fw-semibold"></label>
                                <input asp-for="City" class="form-control" />
                            </div>
                            <div class="col-md-4">
                                <label asp-for="Region" class="form-label fw-semibold"></label>
                                <input asp-for="Region" class="form-control" />
                            </div>
                            <div class="col-md-4">
                                <label asp-for="PostalCode" class="form-label fw-semibold"></label>
                                <input asp-for="PostalCode" class="form-control" />
                            </div>
                            <div class="col-md-4">
                                <label asp-for="Country" class="form-label fw-semibold"></label>
                                <input asp-for="Country" class="form-control" />
                            </div>
                        </div>

                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-warning">Save Changes</button>
                            <a asp-action="Details" asp-route-id="@Model.SupplierId"
                               class="btn btn-outline-secondary">Cancel</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

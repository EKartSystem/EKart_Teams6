@using System.Text.Json
@model IEnumerable<dynamic>

@{
    ViewData["Title"] = "Logistics Manifest";
    var shipperName = ViewBag.ShipperName as string ?? "Unknown Carrier";
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold text-dark mb-1">
                <i class="bi bi-box-seam-fill text-primary me-2"></i>Logistics Manifest
            </h2>
            <p class="text-muted small mb-0">
                Primary Carrier: <strong class="text-dark">@shipperName</strong>
            </p>
        </div>
        <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4 fw-bold shadow-sm text-decoration-none">
            <i class="bi bi-arrow-left me-1"></i> Return to Registry
        </a>
    </div>

    @if (Model == null || !Model.Any())
    {
        <div class="card border-0 shadow-sm text-center py-5">
            <i class="bi bi-exclamation-circle text-info fs-1 mb-3"></i>
            <h5 class="fw-bold">No Records Identified</h5>
        </div>
    }
    else
    {
        <div class="card shadow-sm border-0">
            <div class="card-header bg-primary text-white py-3">
                <h6 class="m-0 fw-bold"><i class="bi bi-list-columns-reverse me-2"></i>Active Dispatch Registry</h6>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="bg-light">
                            <tr>
                                <th class="ps-4 text-uppercase small fw-bold text-secondary">Order ID</th>
                                <th class="text-uppercase small fw-bold text-secondary">Customer</th>
                                <th class="text-uppercase small fw-bold text-secondary">Dispatch Date</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var order in Model)
                            {
                                var element = (JsonElement)order;
                                <tr>
                                    <td class="ps-4 fw-bold text-primary">
                                        #@(element.TryGetProperty("orderId", out var oid) ? oid.ToString() : (element.TryGetProperty("OrderId", out var Oid) ? Oid.ToString() : "N/A"))
                                    </td>
                                    <td class="fw-semibold text-dark">
                                        @(element.TryGetProperty("customerId", out var cid) ? cid.ToString() : (element.TryGetProperty("CustomerId", out var Cid) ? Cid.ToString() : "Unknown"))
                                    </td>
                                    <td>
                                        @{
                                            bool hasDate = element.TryGetProperty("orderDate", out var dProp) || element.TryGetProperty("OrderDate", out dProp);
                                            var displayDate = (hasDate && dProp.ValueKind != JsonValueKind.Null)
                                                ? DateTime.Parse(dProp.ToString()).ToString("dd MMM yyyy")
                                                : "Pending";
                                        }
                                        @displayDate
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
</div>
@model EKartMVC.Models.ShipperViewModel
@{
    ViewData["Title"] = "Shipper Details";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow-sm">
                <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center">
                    <h5 class="mb-0">🚚 Shipper Details</h5>
                    <span class="badge bg-secondary">ID: @Model.ShipperId</span>
                </div>
                <div class="card-body">
                    <dl class="row">
                        <dt class="col-sm-4">Company Name</dt>
                        <dd class="col-sm-8">@Model.CompanyName</dd>

                        <dt class="col-sm-4">Phone</dt>
                        <dd class="col-sm-8">@(Model.Phone ?? "—")</dd>
                    </dl>
                </div>
                <div class="card-footer d-flex gap-2">
                    <a asp-action="Edit" asp-route-id="@Model.ShipperId" class="btn btn-warning">Edit</a>
                    <a asp-action="Orders" asp-route-id="@Model.ShipperId" class="btn btn-secondary">View Orders</a>
                    <a asp-action="Index" class="btn btn-outline-secondary ms-auto">Back to List</a>
                </div>
            </div>
        </div>
    </div>
</div>
